{
  "name": "Inbox triage (Outlook) - drafts only",
  "nodes": [
    {
      "parameters": {
        "content": "## Inbox triage (Outlook / Microsoft 365)\nNew mail goes to the triage service. This workflow then sets **Outlook categories**, creates a **reply draft** in the conversation (Graph `createReply`, then the draft body is filled in) and **posts to Teams** for urgent or complex queries.\n\n**Nothing is ever sent.** The credential only needs `Mail.ReadWrite`. For a shared mailbox, change `/me/` in the Graph URLs to `/users/support@yourcompany.com/`.",
        "height": 280,
        "width": 540,
        "color": 5
      },
      "id": "b593d1e3-2183-5861-b651-b9ae1e2e940a",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -300
      ]
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "output": "raw",
        "filters": {},
        "options": {}
      },
      "id": "bc9fa4f2-26e8-55d1-8e00-b9f9cf0edf1a",
      "name": "New email in shared mailbox",
      "type": "n8n-nodes-base.microsoftOutlookTrigger",
      "typeVersion": 1,
      "position": [
        0,
        100
      ],
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Microsoft Outlook (shared mailbox)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://triage:8000/api/triage",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  provider: 'outlook',\n  message_id: $json.id,\n  thread_id: $json.conversationId,\n  from: `${$json.from?.emailAddress?.name ?? ''} <${$json.from?.emailAddress?.address}>`,\n  to: ($json.toRecipients ?? []).map((r) => ({ email: r.emailAddress.address, name: r.emailAddress.name })),\n  cc: ($json.ccRecipients ?? []).map((r) => ({ email: r.emailAddress.address, name: r.emailAddress.name })),\n  subject: $json.subject ?? '',\n  text: $json.body?.contentType === 'text' ? $json.body.content : null,\n  html: $json.body?.contentType === 'html' ? $json.body.content : null,\n  received_at: $json.receivedDateTime,\n  message_id_header: $json.internetMessageId ?? null\n}) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "3863c8df-360f-5265-925c-20edc9ec928f",
      "name": "Triage with Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Triage API key (X-API-Key)"
        }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://graph.microsoft.com/v1.0/me/messages/{{ $json.message_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOutlookOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ categories: $json.labels }) }}",
        "options": {}
      },
      "id": "6c211b35-2d66-5955-a4a5-7e617484388f",
      "name": "Set categories",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
