# Copy to .env and fill in. Every setting also works as a plain environment variable.

# --- Mode ------------------------------------------------------------------
# demo: offline mailbox seeded by `triage seed-demo`. gmail / graph: a real shared inbox.
MAIL_PROVIDER=demo
# mock: scripted stand-in (no API key). claude: the real assistant.
AI_PROVIDER=mock
# production requires the dashboard login below.
APP_ENV=development
DATABASE_PATH=data/triage.db
# Used in links inside drafts, alerts and the daily summary.
PUBLIC_URL=http://localhost:8000

# --- Claude -----------------------------------------------------------------
# Anthropic API key (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# Effort per step: low | medium | high | xhigh | max
# TRIAGE_EFFORT=low
# DRAFT_EFFORT=medium
# default: a request the safety classifiers decline is re-run on Anthropic's fallback model.
# off: the email is routed to a person instead.
# ANTHROPIC_FALLBACKS=default

# --- Your business -----------------------------------------------------------
MAILBOX_ADDRESS=support@tidewater.example
# Comma-separated. Mail from these domains is the team's own, not a client's.
TEAM_DOMAINS=tidewater.example
REPLY_SIGNATURE="Best regards,\nTidewater Payroll Client Support"
# Put a "review, then delete" note with sources at the top of each draft.
# DRAFT_REVIEW_NOTE=true
# BUSINESS_PROFILE_FILE=fixtures/demo/business_profile.md
# CLIENTS_FILE=fixtures/demo/clients.csv
# ROUTING_FILE=fixtures/demo/routing.yaml
# PRIVACY_FILE=fixtures/demo/privacy.yaml
# KB_DIR=fixtures/demo/kb
# Or use an external knowledge service (e.g. the Project 4 knowledge base API) instead of KB_DIR:
# KB_URL=https://kb.yourcompany.com/api
# KB_API_KEY=

# --- Polling and the daily summary --------------------------------------------
# Run the poller and the daily summary inside `triage serve`.
SCHEDULER_ENABLED=false
# POLL_SECONDS=120
# LOOKBACK_DAYS=3
# DIGEST_TIME=08:45
# DIGEST_DAYS=mon-fri
# TIMEZONE=Europe/London

# --- Notifications --------------------------------------------------------------
# log: kept in the dashboard's outbox only. slack | teams: also posted to a webhook.
NOTIFY=log
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TEAMS_WEBHOOK_URL=https://prod-00.westeurope.logic.azure.com/workflows/...

# --- Dashboard login and API key ----------------------------------------------------
# Required in production. Password: at least 12 characters.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=
# For n8n and scripts calling /api/* (sent as the X-API-Key header).
# API_KEY=
# SECRET_KEY=   # signs form tokens; set a long random value in production

# --- Gmail (MAIL_PROVIDER=gmail), see docs/SETUP-GMAIL.md --------------------------
# GMAIL_CLIENT_SECRETS_FILE=secrets/gmail-client.json
# GMAIL_TOKEN_FILE=secrets/gmail-token.json
# GMAIL_SERVICE_ACCOUNT_FILE=secrets/service-account.json
# GMAIL_DELEGATED_USER=support@yourcompany.com

# --- Microsoft 365 (MAIL_PROVIDER=graph), see docs/SETUP-M365.md ---------------------
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_MAILBOX=support@yourcompany.com
